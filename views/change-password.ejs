<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matter Cameras — Change Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 20px;
            padding: 40px 36px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 24px 60px rgba(148, 163, 184, 0.22);
        }

        .login-logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
            text-align: center;
        }

        .login-logo-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
        }

        .login-logo-icon .material-symbols-outlined {
            font-size: 28px;
            color: #ffffff;
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .login-logo h1 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

        .login-logo p {
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin: 0;
        }

        .login-form label {
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .login-form input {
            margin-bottom: 16px;
            font-size: 0.95rem;
            border-radius: 10px;
            border: 1.5px solid var(--border-color);
            padding: 11px 14px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .login-form input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            padding-right: 44px;
            width: 100%;
            box-sizing: border-box;
        }

        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-68%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-secondary);
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .password-toggle:hover {
            color: var(--text-primary);
        }

        .password-toggle .material-symbols-outlined {
            font-size: 20px;
        }

        .login-submit {
            width: 100%;
            margin-top: 4px;
            gap: 8px;
            font-size: 0.95rem;
        }

        .login-submit .material-symbols-outlined {
            font-size: 18px;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .login-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.85rem;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon">
                <span class="material-symbols-outlined">lock_reset</span>
            </div>
            <h1>Change Password</h1>
            <p>First login — please set a secure password</p>
        </div>

        <% if (locals.error) { %>
            <div class="login-error"><%= error %></div>
        <% } %>

        <form class="login-form" action="/change-password" method="POST" id="change-password-form">
            <label for="newPassword">New Password</label>
            <div class="password-wrapper">
                <input type="password" id="newPassword" name="newPassword" placeholder="••••••••" autocomplete="new-password" required>
                <button type="button" class="password-toggle" data-target="newPassword" aria-label="Toggle password visibility">
                    <span class="material-symbols-outlined">visibility</span>
                </button>
            </div>

            <label for="confirmPassword">Confirm Password</label>
            <div class="password-wrapper">
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" autocomplete="new-password" required>
                <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Toggle password visibility">
                    <span class="material-symbols-outlined">visibility</span>
                </button>
            </div>

            <div id="match-error" style="display:none; color:#991b1b; font-size:0.82rem; margin: -10px 0 12px;">
                Passwords do not match.
            </div>

            <button type="submit" class="btn login-submit">
                <span class="material-symbols-outlined">lock_reset</span>
                Set New Password
            </button>
        </form>
    </div>

    <script>
        document.querySelectorAll('.password-toggle').forEach(toggle => {
            toggle.addEventListener('click', () => {
                const targetId = toggle.dataset.target;
                const input = document.getElementById(targetId);
                const icon = toggle.querySelector('.material-symbols-outlined');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.textContent = 'visibility_off';
                } else {
                    input.type = 'password';
                    icon.textContent = 'visibility';
                }
            });
        });

        document.getElementById('change-password-form').addEventListener('submit', (e) => {
            const pw = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            const matchError = document.getElementById('match-error');
            if (pw !== confirm) {
                e.preventDefault();
                matchError.style.display = 'block';
            } else {
                matchError.style.display = 'none';
            }
        });
    </script>
</body>
</html>
