<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matter Cameras Bridge — Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --accent:        #2563eb;
            --accent-hover:  #1d4ed8;
            --text-primary:  #1d2939;
            --text-secondary:#4a5a6e;
            --text-muted:    #8a9bb0;
            --border:        rgba(148, 163, 184, 0.22);
            --card-bg:       rgba(255, 255, 255, 0.78);
            --radius-lg:     20px;
            --radius-md:     12px;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: stretch;
            overflow: hidden;
            background: #f0f4fa;
        }

        /* ── Animated canvas — soft light orbs on white ── */
        #bg-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
        }

        /* ── Layout ── */
        .page-wrap {
            position: relative;
            z-index: 1;
            display: flex;
            width: 100%;
        }

        /* ── Left panel ── */
        .left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 52px 60px;
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            border-right: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .brand-icon .material-symbols-outlined {
            font-size: 22px;
            color: #fff;
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .brand-name {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        .hero {
            max-width: 520px;
        }

        .hero h1 {
            font-size: clamp(2.2rem, 3.5vw, 3rem);
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.08;
            letter-spacing: -0.03em;
            margin-bottom: 18px;
        }

        .hero h1 span {
            background: linear-gradient(135deg, #2563eb, #38bdf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1rem;
            font-weight: 400;
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 44px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .feature-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 16px;
            background: rgba(255, 255, 255, 0.72);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            backdrop-filter: blur(12px);
            transition: background 0.2s ease, transform 0.2s ease;
        }

        .feature-chip:hover {
            background: rgba(255, 255, 255, 0.92);
            transform: translateY(-1px);
        }

        .feature-chip .chip-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            min-width: 34px;
            background: rgba(37, 99, 235, 0.08);
            border-radius: 9px;
        }

        .feature-chip .chip-icon .material-symbols-outlined {
            font-size: 18px;
            color: var(--accent);
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }

        .feature-chip .chip-text strong {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 1px;
        }

        .feature-chip .chip-text span {
            font-size: 0.72rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .left-footer {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .left-footer .material-symbols-outlined {
            font-size: 14px;
        }

        /* ── Right panel — login form ── */
        .right-panel {
            position: relative;
            width: 400px;
            min-width: 360px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
        }

        .login-box {
            width: 100%;
            animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .login-box h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.025em;
            margin-bottom: 6px;
        }

        .login-box .login-sub {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 7px;
            letter-spacing: 0.01em;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            pointer-events: none;
        }

        .input-wrap .input-icon .material-symbols-outlined {
            font-size: 17px;
            color: #a0aec0;
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }

        .input-wrap input {
            width: 100%;
            padding: 11px 42px 11px 38px;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-primary);
            background: rgba(248, 250, 252, 0.9);
            border: 1.5px solid rgba(148, 163, 184, 0.28);
            border-radius: var(--radius-md);
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
            -webkit-appearance: none;
        }

        .input-wrap input::placeholder {
            color: #b0bec8;
        }

        .input-wrap input:focus {
            border-color: var(--accent);
            background: #ffffff;
            box-shadow: 0 0 0 3.5px rgba(37, 99, 235, 0.1);
        }

        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #a0aec0;
            padding: 4px;
            display: flex;
            align-items: center;
            transition: color 0.15s;
        }

        .password-toggle:hover { color: var(--text-secondary); }

        .password-toggle .material-symbols-outlined {
            font-size: 17px;
        }

        .login-error {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #9f1239;
            border-radius: var(--radius-md);
            padding: 10px 14px;
            font-size: 0.82rem;
            margin-bottom: 20px;
            animation: shakeIn 0.3s ease;
        }

        .login-error .material-symbols-outlined {
            font-size: 16px;
            flex-shrink: 0;
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        @keyframes shakeIn {
            0%   { opacity: 0; transform: translateX(-6px); }
            60%  { transform: translateX(3px); }
            100% { opacity: 1; transform: translateX(0); }
        }

        .btn-login {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 20px;
            margin-top: 8px;
            font-family: inherit;
            font-size: 0.92rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            letter-spacing: 0.01em;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28), inset 0 1px 0 rgba(255,255,255,0.15);
            transition: opacity 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        }

        .btn-login:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 22px rgba(37, 99, 235, 0.36), inset 0 1px 0 rgba(255,255,255,0.15);
        }

        .btn-login:active {
            transform: translateY(0);
            opacity: 1;
        }

        .btn-login .material-symbols-outlined {
            font-size: 17px;
        }

        /* ── Mobile ── */
        @media (max-width: 820px) {
            body { flex-direction: column; overflow: auto; }
            .left-panel {
                padding: 36px 28px 28px;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }
            .feature-grid { grid-template-columns: 1fr; }
            .left-footer { display: none; }
            .hero p { margin-bottom: 24px; }
            .right-panel {
                width: 100%;
                min-width: unset;
                padding: 36px 28px 48px;
            }
        }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>

    <div class="page-wrap">

        <!-- Left panel -->
        <div class="left-panel">
            <div class="brand">
                <div class="brand-icon">
                    <span class="material-symbols-outlined">videocam</span>
                </div>
                <span class="brand-name">Matter Cameras Bridge</span>
            </div>

            <div class="hero">
                <h1>Your cameras,<br><span>Matter-ready.</span></h1>
                <p>
                    Bridge any RTSP or ONVIF IP camera into the Matter ecosystem.
                    Works with SmartThings, Apple Home, Google Home, and every Matter-compatible hub.
                </p>

                <div class="feature-grid">
                    <div class="feature-chip">
                        <div class="chip-icon">
                            <span class="material-symbols-outlined">hub</span>
                        </div>
                        <div class="chip-text">
                            <strong>Matter 1.5</strong>
                            <span>Universal smart home protocol</span>
                        </div>
                    </div>
                    <div class="feature-chip">
                        <div class="chip-icon">
                            <span class="material-symbols-outlined">wifi_tethering</span>
                        </div>
                        <div class="chip-text">
                            <strong>RTSP &amp; ONVIF</strong>
                            <span>Any standard IP camera</span>
                        </div>
                    </div>
                    <div class="feature-chip">
                        <div class="chip-icon">
                            <span class="material-symbols-outlined">motion_sensor_active</span>
                        </div>
                        <div class="chip-text">
                            <strong>Motion Detection</strong>
                            <span>Frame-diff, ONVIF &amp; native events</span>
                        </div>
                    </div>
                    <div class="feature-chip">
                        <div class="chip-icon">
                            <span class="material-symbols-outlined">live_tv</span>
                        </div>
                        <div class="chip-text">
                            <strong>Live Streaming</strong>
                            <span>Low-latency WebRTC via go2rtc</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="left-footer">
                <span class="material-symbols-outlined">lock</span>
                Local network — secured access
            </div>
        </div>

        <!-- Right panel — login form -->
        <div class="right-panel">
            <div class="login-box">
                <h2>Welcome back</h2>
                <p class="login-sub">Sign in to manage your camera bridge</p>

                <% if (locals.error) { %>
                    <div class="login-error">
                        <span class="material-symbols-outlined">error</span>
                        <%= error %>
                    </div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <span class="material-symbols-outlined">person</span>
                            </span>
                            <input type="text" id="username" name="username" placeholder="admin"
                                autocomplete="username" required autofocus>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <span class="material-symbols-outlined">lock</span>
                            </span>
                            <input type="password" id="password" name="password" placeholder="••••••••"
                                autocomplete="current-password" required>
                            <button type="button" class="password-toggle" id="pw-toggle" aria-label="Toggle password">
                                <span class="material-symbols-outlined" id="pw-icon">visibility</span>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        <span class="material-symbols-outlined">login</span>
                        Sign In
                    </button>
                </form>
            </div>
        </div>

    </div><!-- /page-wrap -->

    <script>
        /* Password visibility toggle */
        document.getElementById('pw-toggle').addEventListener('click', () => {
            const input = document.getElementById('password');
            const icon  = document.getElementById('pw-icon');
            const show  = input.type === 'password';
            input.type  = show ? 'text' : 'password';
            icon.textContent = show ? 'visibility_off' : 'visibility';
        });

        /* Animated background — soft light orbs on white (Apple-style) */
        (function () {
            const canvas = document.getElementById('bg-canvas');
            const ctx    = canvas.getContext('2d');

            const ORBS = [
                { rx: 0.15, ry: 0.25, r: 0.38, hue: 215, sat: 90, lit: 70, alpha: 0.22, speed: 0.00016 },
                { rx: 0.70, ry: 0.55, r: 0.30, hue: 200, sat: 85, lit: 68, alpha: 0.18, speed: 0.00020 },
                { rx: 0.85, ry: 0.10, r: 0.24, hue: 235, sat: 80, lit: 72, alpha: 0.16, speed: 0.00018 },
                { rx: 0.30, ry: 0.80, r: 0.26, hue: 205, sat: 88, lit: 66, alpha: 0.14, speed: 0.00014 },
                { rx: 0.55, ry: 0.30, r: 0.20, hue: 190, sat: 75, lit: 74, alpha: 0.12, speed: 0.00022 },
            ];

            let w, h;

            function resize() {
                w = canvas.width  = window.innerWidth;
                h = canvas.height = window.innerHeight;
            }

            function draw(ts) {
                /* White base */
                ctx.fillStyle = '#f0f4fa';
                ctx.fillRect(0, 0, w, h);

                /* Soft orbs */
                for (const o of ORBS) {
                    const ox = o.rx * w + Math.sin(ts * o.speed + o.hue * 0.05) * w * 0.07;
                    const oy = o.ry * h + Math.cos(ts * o.speed * 0.75 + o.hue * 0.03) * h * 0.06;
                    const rad = o.r * Math.min(w, h);

                    const g = ctx.createRadialGradient(ox, oy, 0, ox, oy, rad);
                    g.addColorStop(0,   `hsla(${o.hue}, ${o.sat}%, ${o.lit}%, ${o.alpha})`);
                    g.addColorStop(0.55,`hsla(${o.hue}, ${o.sat}%, ${o.lit}%, ${o.alpha * 0.4})`);
                    g.addColorStop(1,   `hsla(${o.hue}, ${o.sat}%, ${o.lit}%, 0)`);

                    ctx.beginPath();
                    ctx.arc(ox, oy, rad, 0, Math.PI * 2);
                    ctx.fillStyle = g;
                    ctx.fill();
                }

                requestAnimationFrame(draw);
            }

            resize();
            window.addEventListener('resize', resize);
            requestAnimationFrame(draw);
        })();
    </script>
</body>
</html>
